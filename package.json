{
  "name": "saa-region-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Region Builder: a game-style study app for AWS Certified Solutions Architect - Associate (SAA-C03)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "tsx scripts/test-layout.ts",
    "fetch:official": "tsx scripts/fetch-official.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:hygiene": "tsx scripts/check-hygiene.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:content && npm run build && npm run check:bundle && npm run check:hygiene",
    "check:all": "npm run check && npm run check:links && npm run test:layout",
    "check:links": "tsx scripts/check-links.ts",
    "page": "tsx scripts/page.ts",
    "q": "tsx scripts/q.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
